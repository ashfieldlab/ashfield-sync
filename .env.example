# Ashfield Drive 서버의 base URL
# 로컬 dev: http://localhost:13800 (BACKEND_HOST_PORT)
# 운영: 본인 서버 주소 (예: https://drive.example.com)
# ※ src-tauri/capabilities/default.json 의 http allowlist 에도 같은 호스트를 추가해야 함.
VITE_API_URL=https://drive.example.com

# OIDC (OAuth 2.0 + PKCE)
VITE_OAUTH_ISSUER=https://auth.example.com/realms/ashfield
VITE_OAUTH_CLIENT_ID=ashfield-sync
# loopback callback 포트 — IdP client 에 등록된 redirect_uri 의 포트와 일치해야.
# Tauri dev vite 가 1420 사용 → 1421 안전.
VITE_OAUTH_REDIRECT_PORT=1421
