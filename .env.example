# ── Ashfield 계정 서버 (OIDC issuer) ─────────────────────────────────────────
# 로그인은 계정 서버로 한다. 엔드포인트는 ${VITE_ACCOUNT_URL}/.well-known/openid-configuration
# 에서 읽는다 (실패 시 /api/auth/oauth2/{authorize,token,revoke} 로 fallback).
# 로컬 dev: http://localhost:3300, 운영: 예) https://account.example.com
VITE_ACCOUNT_URL=http://localhost:3300

# ── Ashfield Drive ──────────────────────────────────────────────────────────
# Drive **API base** (백엔드): /api/v1/* 호출 대상. 로컬 dev: http://localhost:8200
# ※ src-tauri/capabilities/default.json 의 http allowlist 에도 같은 호스트를 추가해야 함.
#   (계정 서버 호출은 Rust 에서만 하므로 allowlist 불필요)
VITE_DRIVE_URL=http://localhost:8200

# OAuth `resource` (RFC 8707) = access token 의 `aud`.
# 계정 서버가 ashfield-sync 에 연결한 resource: 계정 서버의 DRIVE_URL, 즉 Drive 의 **public URL**
# (프론트엔드 주소, 로컬 dev: http://localhost:3200) 과 정확히 같아야 한다 (끝 슬래시 없음).
# Drive 백엔드는 AUTH_AUDIENCE=<이 값> 으로 aud 를 검증한다. API base 와 다르므로 별도 설정.
# 운영에서 프론트와 API 가 한 도메인이면 VITE_DRIVE_URL 과 같은 값이 된다 (예: https://drive.example.com).
VITE_DRIVE_RESOURCE=http://localhost:3200

# ── OAuth 클라이언트 ────────────────────────────────────────────────────────
# 계정 서버에 등록된 public client (PKCE S256 필수, secret 없음)
VITE_OAUTH_CLIENT_ID=ashfield-sync
# loopback callback 포트: redirect_uri 는 http://127.0.0.1:<포트>/oauth/callback 으로 고정이며
# 계정 서버의 SYNC_REDIRECT_URIS 에 등록된 값과 정확히 일치해야 한다.
# Tauri dev vite 가 1420 사용 → 1421 안전.
VITE_OAUTH_REDIRECT_PORT=1421
